@page "/"
@rendermode InteractiveServer
@inject IMenuService MenuService
@inject MenuChangeNotifier MenuChanges

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

<p class="lead">Welcome to your new app.</p>

<div class="home-panels d-flex flex-column gap-4">
    <div class="home-panel card">
        <div class="card-body">
            <h2 class="card-title h5">New menu item</h2>
            <p class="card-text text-muted small">Add an entry to the sidebar navigation.</p>

            @if (statusMessage is not null)
            {
                <div class="alert @(isError ? "alert-danger" : "alert-success") py-2" role="alert">
                    @statusMessage
                </div>
            }

            <EditForm Model="model" OnValidSubmit="HandleCreateAsync" class="menu-item-form">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label" for="menu-title">Title</label>
                    <InputText id="menu-title" class="form-control" @bind-Value="model.Title" />
                    <ValidationMessage For="@(() => model.Title)" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="menu-url">URL</label>
                    <InputText id="menu-url" class="form-control" @bind-Value="model.Url" placeholder="/path or leave empty for a group" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="menu-icon">Icon</label>
                    <InputText id="menu-icon" class="form-control" @bind-Value="model.Icon" placeholder="bi-house-door" />
                    <div class="form-text">Bootstrap Icons class name, without the <code>bi</code> prefix if you prefer — stored as entered.</div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label" for="menu-parent">Parent</label>
                        <InputSelect id="menu-parent" class="form-select" @bind-Value="ParentIdValue">
                            <option value="">Top level</option>
                            @foreach (var item in parentOptions)
                            {
                                <option value="@item.Id">@item.Title</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="menu-sort">Sort order</label>
                        <InputNumber id="menu-sort" class="form-control" @bind-Value="model.SortOrder" />
                    </div>
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox id="menu-active" class="form-check-input" @bind-Value="model.IsActive" />
                    <label class="form-check-label" for="menu-active">Active</label>
                </div>

                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                    @(isSaving ? "Saving…" : "Create menu item")
                </button>
            </EditForm>
        </div>
    </div>
    <div class="home-panel card">
        <div class="card-body">
            <h2 class="card-title h5">Update menu item</h2>
            <p class="card-text text-muted small">Select an entry, edit its fields, and save.</p>

            @if (editStatusMessage is not null)
            {
                <div class="alert @(editIsError ? "alert-danger" : "alert-success") py-2" role="alert">
                    @editStatusMessage
                </div>
            }

            <div class="mb-3">
                <label class="form-label" for="edit-menu-select">Menu item</label>
                <InputSelect id="edit-menu-select" class="form-select" @bind-Value="SelectedEditId" @bind-Value:after="LoadEditModel">
                    <option value="">Choose an item…</option>
                    @foreach (var item in allMenuItems)
                    {
                        <option value="@item.Id">@FormatMenuItemLabel(item)</option>
                    }
                </InputSelect>
            </div>

            @if (editModel.Id > 0)
            {
                <EditForm Model="editModel" OnValidSubmit="HandleUpdateAsync" class="menu-item-form">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label" for="edit-menu-title">Title</label>
                        <InputText id="edit-menu-title" class="form-control" @bind-Value="editModel.Title" />
                        <ValidationMessage For="@(() => editModel.Title)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="edit-menu-url">URL</label>
                        <InputText id="edit-menu-url" class="form-control" @bind-Value="editModel.Url" placeholder="/path or leave empty for a group" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="edit-menu-icon">Icon</label>
                        <InputText id="edit-menu-icon" class="form-control" @bind-Value="editModel.Icon" placeholder="bi-house-door" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label" for="edit-menu-parent">Parent</label>
                            <InputSelect id="edit-menu-parent" class="form-select" @bind-Value="EditParentIdValue">
                                <option value="">Top level</option>
                                @foreach (var item in editParentOptions)
                                {
                                    <option value="@item.Id">@item.Title</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="edit-menu-sort">Sort order</label>
                            <InputNumber id="edit-menu-sort" class="form-control" @bind-Value="editModel.SortOrder" />
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        <InputCheckbox id="edit-menu-active" class="form-check-input" @bind-Value="editModel.IsActive" />
                        <label class="form-check-label" for="edit-menu-active">Active</label>
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@editIsSaving">
                        @(editIsSaving ? "Saving…" : "Save changes")
                    </button>
                </EditForm>
            }
        </div>
    </div>
    <div class="home-panel card">
        <div class="card-body">
            <h2 class="card-title h5">Delete menu item</h2>
            <p class="card-text text-muted small">Select an entry and remove it permanently.</p>

            @if (deleteStatusMessage is not null)
            {
                <div class="alert @(deleteIsError ? "alert-danger" : "alert-success") py-2" role="alert">
                    @deleteStatusMessage
                </div>
            }

            <div class="mb-3">
                <label class="form-label" for="delete-menu-select">Menu item</label>
                <InputSelect id="delete-menu-select" class="form-select" @bind-Value="SelectedDeleteId" @bind-Value:after="OnDeleteSelectionChanged">
                    <option value="">Choose an item…</option>
                    @foreach (var item in allMenuItems)
                    {
                        <option value="@item.Id">@FormatMenuItemLabel(item)</option>
                    }
                </InputSelect>
            </div>

            @if (deleteTarget is not null)
            {
                @if (deleteChildCount > 0)
                {
                    <div class="alert alert-warning py-2 mb-0" role="alert">
                        This item has @deleteChildCount child @(deleteChildCount == 1 ? "item" : "items"). Delete or reassign them before removing this entry.
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-3">Delete <strong>@deleteTarget.Title</strong>? This cannot be undone.</p>
                    <button type="button" class="btn btn-danger" disabled="@deleteIsSaving" @onclick="HandleDeleteAsync">
                        @(deleteIsSaving ? "Deleting…" : "Delete menu item")
                    </button>
                }
            }
        </div>
    </div>
</div>

@code {
    private MenuItem model = new() { IsActive = true };
    private MenuItem editModel = new() { IsActive = true };
    private List<MenuItem> allMenuItems = [];
    private List<MenuItem> parentOptions = [];
    private List<MenuItem> editParentOptions = [];
    private string? statusMessage;
    private string? editStatusMessage;
    private bool isError;
    private bool editIsError;
    private bool isSaving;
    private bool editIsSaving;
    private string? deleteStatusMessage;
    private bool deleteIsError;
    private bool deleteIsSaving;
    private string selectedEditId = "";
    private string selectedDeleteId = "";
    private MenuItem? deleteTarget;
    private int deleteChildCount;

    private string ParentIdValue
    {
        get => model.ParentId?.ToString() ?? "";
        set => model.ParentId = string.IsNullOrEmpty(value) ? null : int.Parse(value);
    }

    private string SelectedEditId
    {
        get => selectedEditId;
        set => selectedEditId = value;
    }

    private string EditParentIdValue
    {
        get => editModel.ParentId?.ToString() ?? "";
        set => editModel.ParentId = string.IsNullOrEmpty(value) ? null : int.Parse(value);
    }

    private string SelectedDeleteId
    {
        get => selectedDeleteId;
        set => selectedDeleteId = value;
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshMenuListsAsync();
    }

    private async Task RefreshMenuListsAsync()
    {
        allMenuItems = await MenuService.GetAllMenuItemsAsync();
        parentOptions = allMenuItems;
        if (editModel.Id > 0)
        {
            editParentOptions = allMenuItems.Where(m => m.Id != editModel.Id).ToList();
        }
    }

    private void LoadEditModel()
    {
        editStatusMessage = null;

        if (string.IsNullOrEmpty(selectedEditId))
        {
            editModel = new MenuItem { IsActive = true };
            editParentOptions = [];
            return;
        }

        var id = int.Parse(selectedEditId);
        var source = allMenuItems.First(m => m.Id == id);
        editModel = new MenuItem
        {
            Id = source.Id,
            ParentId = source.ParentId,
            Title = source.Title,
            Url = source.Url,
            Icon = source.Icon,
            SortOrder = source.SortOrder,
            IsActive = source.IsActive
        };
        editParentOptions = allMenuItems.Where(m => m.Id != id).ToList();
    }

    private void OnDeleteSelectionChanged()
    {
        deleteStatusMessage = null;
        deleteTarget = null;
        deleteChildCount = 0;

        if (string.IsNullOrEmpty(selectedDeleteId))
            return;

        var id = int.Parse(selectedDeleteId);
        deleteTarget = allMenuItems.First(m => m.Id == id);
        deleteChildCount = allMenuItems.Count(m => m.ParentId == id);
    }

    private static string FormatMenuItemLabel(MenuItem item)
    {
        var indent = item.ParentId is null ? "" : "— ";
        return $"{indent}{item.Title} (#{item.Id})";
    }

    private async Task HandleCreateAsync()
    {
        isSaving = true;
        statusMessage = null;

        try
        {
            var created = await MenuService.CreateMenuItemAsync(model);
            await MenuChanges.NotifyAsync();

            statusMessage = $"Created \"{created.Title}\".";
            isError = false;
            model = new MenuItem { IsActive = true };
            await RefreshMenuListsAsync();
            LoadEditModel();
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleUpdateAsync()
    {
        editIsSaving = true;
        editStatusMessage = null;

        try
        {
            var updated = await MenuService.UpdateMenuItemAsync(editModel);
            await MenuChanges.NotifyAsync();

            editStatusMessage = $"Updated \"{updated.Title}\".";
            editIsError = false;
            selectedEditId = updated.Id.ToString();
            await RefreshMenuListsAsync();
            LoadEditModel();
        }
        catch (Exception ex)
        {
            editStatusMessage = ex.Message;
            editIsError = true;
        }
        finally
        {
            editIsSaving = false;
        }
    }

    private async Task HandleDeleteAsync()
    {
        if (deleteTarget is null)
            return;

        deleteIsSaving = true;
        deleteStatusMessage = null;

        try
        {
            var title = deleteTarget.Title;
            var deletedId = deleteTarget.Id;
            await MenuService.DeleteMenuItemAsync(deletedId);
            await MenuChanges.NotifyAsync();

            deleteStatusMessage = $"Deleted \"{title}\".";
            deleteIsError = false;
            selectedDeleteId = "";
            deleteTarget = null;
            deleteChildCount = 0;

            if (selectedEditId == deletedId.ToString())
            {
                selectedEditId = "";
                editModel = new MenuItem { IsActive = true };
                editParentOptions = [];
            }

            await RefreshMenuListsAsync();
        }
        catch (Exception ex)
        {
            deleteStatusMessage = ex.Message;
            deleteIsError = true;
        }
        finally
        {
            deleteIsSaving = false;
        }
    }

}
